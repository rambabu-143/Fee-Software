generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A school or branch. Everything else hangs off this.
model School {
  id            Int              @id @default(autoincrement())
  code          String           @unique
  name          String
  standards     Standard[]
  feeHeads      FeeHead[]
  installments  Installment[]
  students      Student[]
  users         User[]
  payments      Payment[]
  facilities    Facility[]
  affiliationNo String?
  schoolNo      String?
  address       String?
  kind          SchoolKind       @default(SENIOR)
  occupations   Occupation[]
  subjects      Subject[]
  documents     IssuedDocument[]
  banks         Bank[]
  vouchers      Voucher[]
}

// "2026-27". Fee rules are rows keyed by year, not a new source file per year.
model AcademicYear {
  id                 Int                    @id @default(autoincrement())
  label              String                 @unique
  startDate          DateTime               @db.Date
  endDate            DateTime               @db.Date
  isCurrent          Boolean                @default(false)
  installments       Installment[]
  structures         FeeStructure[]
  enrollments        Enrollment[]
  payments           Payment[]
  facilityStructures FacilityFeeStructure[]
  documents          IssuedDocument[]
  vouchers           Voucher[]
  deposits           Deposit[]
  arrearsFrom        ArrearCarry[]
}

model Standard {
  id         Int            @id @default(autoincrement())
  schoolId   Int
  school     School         @relation(fields: [schoolId], references: [id])
  name       String
  sortOrder  Int
  sections   Section[]
  structures FeeStructure[]

  @@unique([schoolId, name])
}

model Section {
  id           Int          @id @default(autoincrement())
  standardId   Int
  standard     Standard     @relation(fields: [standardId], references: [id])
  name         String
  enrollments  Enrollment[]
  classTeacher String?

  @@unique([standardId, name])
}

model Student {
  id            Int              @id @default(autoincrement())
  schoolId      Int
  school        School           @relation(fields: [schoolId], references: [id])
  admissionNo   String
  name          String
  dob           DateTime?        @db.Date
  fatherName    String?
  motherName    String?
  phone         String?
  email         String?
  active        Boolean          @default(true)
  enrollments   Enrollment[]
  payments      Payment[]
  gender        Gender?
  religion      String?
  category      String?
  nationality   String?          @default("INDIAN")
  aadhaar       String?
  penNo         String?
  cbseRegNo     String?
  address       String?
  admissionDate DateTime?        @db.Date
  fatherEmail   String?
  motherEmail   String?
  // Manual sibling link: students sharing a familyId are siblings.
  familyId      Int?
  guardians     Guardian[]
  documents     IssuedDocument[]
  deposits      Deposit[]

  @@unique([schoolId, admissionNo])
}

// Which class/section a student is in for a given year. Promotion = new row.
model Enrollment {
  id                  Int                  @id @default(autoincrement())
  studentId           Int
  student             Student              @relation(fields: [studentId], references: [id])
  yearId              Int
  year                AcademicYear         @relation(fields: [yearId], references: [id])
  sectionId           Int
  section             Section              @relation(fields: [sectionId], references: [id])
  rollNo              Int?
  // New admissions pay ADMISSION and REFUNDABLE heads; continuing students don't.
  isNewAdmission      Boolean              @default(false)
  // OPTIONAL heads (e.g. Computer Fee) apply only if opted in here.
  optionalHeads       FeeHead[]
  concessions         Concession[]
  fineAdjustments     FineAdjustment[]
  facilityAssignments FacilityAssignment[]
  withdrawal          Withdrawal?
  transport           TransportAssignment?
  subjects            StudentSubject[]
  vouchers            Voucher[]
  arrearCarry         ArrearCarry?
  transportRenewal    TransportRenewal?

  @@unique([studentId, yearId])
}

enum FeeHeadType {
  ADMISSION
  ANNUAL
  MONTHLY
  REFUNDABLE
  OPTIONAL
}

model FeeHead {
  id          Int            @id @default(autoincrement())
  schoolId    Int
  school      School         @relation(fields: [schoolId], references: [id])
  name        String
  type        FeeHeadType
  structures  FeeStructure[]
  optedBy     Enrollment[]
  concessions Concession[]

  @@unique([schoolId, name])
}

model Installment {
  id                 Int                    @id @default(autoincrement())
  schoolId           Int
  school             School                 @relation(fields: [schoolId], references: [id])
  yearId             Int
  year               AcademicYear           @relation(fields: [yearId], references: [id])
  number             Int
  label              String
  dueDate            DateTime               @db.Date
  fineStartDate      DateTime?              @db.Date
  // Flat late fine per day from fineStartDate while the installment is unpaid.
  finePerDay         Decimal                @default(0) @db.Decimal(10, 2)
  structures         FeeStructure[]
  allocations        PaymentAllocation[]
  facilityStructures FacilityFeeStructure[]
  fineAdjustments    FineAdjustment[]

  @@unique([schoolId, yearId, number])
}

// The fee "config": amount of a head, for a class, in an installment, in a year.
model FeeStructure {
  id            Int          @id @default(autoincrement())
  yearId        Int
  year          AcademicYear @relation(fields: [yearId], references: [id])
  standardId    Int
  standard      Standard     @relation(fields: [standardId], references: [id])
  feeHeadId     Int
  feeHead       FeeHead      @relation(fields: [feeHeadId], references: [id])
  installmentId Int
  installment   Installment  @relation(fields: [installmentId], references: [id])
  amount        Decimal      @db.Decimal(12, 2)

  @@unique([yearId, standardId, feeHeadId, installmentId])
}

enum Role {
  SUPERADMIN
  ADMIN
  ACCOUNTANT
  VIEWER
}

model User {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  passwordHash String
  role         Role
  // null = access to all schools (superadmin)
  schoolId     Int?
  school       School? @relation(fields: [schoolId], references: [id])
  active       Boolean @default(true)
}

enum PaymentMode {
  CASH
  CHEQUE
  UPI
  BANK_TRANSFER
  CARD
}

// One receipt. Never deleted: cancelled receipts keep their number and stop counting.
model Payment {
  id           Int                 @id @default(autoincrement())
  schoolId     Int
  school       School              @relation(fields: [schoolId], references: [id])
  yearId       Int
  year         AcademicYear        @relation(fields: [yearId], references: [id])
  studentId    Int
  student      Student             @relation(fields: [studentId], references: [id])
  receiptNo    Int
  date         DateTime            @db.Date
  mode         PaymentMode
  reference    String?
  remarks      String?
  amount       Decimal             @db.Decimal(12, 2)
  createdBy    String
  createdAt    DateTime            @default(now())
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?
  allocations  PaymentAllocation[]
  // Banking: cheques/online receipts are PENDING until the bank credits them. CASH is CLEARED.
  bankId       Int?
  bank         Bank?               @relation(fields: [bankId], references: [id])
  chequeNo     String?
  chequeDate   DateTime?           @db.Date
  bankDate     DateTime?           @db.Date
  clearStatus  ClearStatus         @default(CLEARED)
  bouncedAt    DateTime?
  bounceCharge Decimal?            @db.Decimal(12, 2)
  deposits     Deposit[]

  @@unique([schoolId, yearId, receiptNo])
  @@index([studentId, yearId])
}

// How a receipt's amount was split across installments.
model PaymentAllocation {
  id            Int          @id @default(autoincrement())
  paymentId     Int
  payment       Payment      @relation(fields: [paymentId], references: [id])
  // null installment = the previous-year arrear line.
  installmentId Int?
  installment   Installment? @relation(fields: [installmentId], references: [id])
  charges       Decimal      @db.Decimal(12, 2)
  fine          Decimal      @db.Decimal(12, 2)
  arrear        Decimal      @default(0) @db.Decimal(12, 2)
  // Bounce charge of an earlier bounced cheque, paid off by this receipt (null-installment row, like arrear).
  bounce        Decimal      @default(0) @db.Decimal(12, 2)
  // Exact split of `charges` across the installment's fee heads (see splitHeads in billing/bill.ts).
  heads         PaymentAllocationHead[]
}

// One fee head's share of an allocation's charges. feeHeadId is plain (no FK): facility/transport lines carry
// negative ids and 0 means "unallocated"; `name` and `refundable` are snapshots so reports never join back.
model PaymentAllocationHead {
  id           Int               @id @default(autoincrement())
  allocationId Int
  allocation   PaymentAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  feeHeadId    Int
  name         String
  refundable   Boolean           @default(false)
  amount       Decimal           @db.Decimal(12, 2)

  @@index([allocationId])
}

model ReceiptCounter {
  schoolId Int
  yearId   Int
  last     Int

  @@id([schoolId, yearId])
}

// Discount on one fee head for one student-year, applied to every installment of that head.
// Exactly one of percent / amount (per installment); enforced by a CHECK in the migration.
model Concession {
  id           Int        @id @default(autoincrement())
  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  feeHeadId    Int
  feeHead      FeeHead    @relation(fields: [feeHeadId], references: [id])
  percent      Decimal?   @db.Decimal(5, 2)
  amount       Decimal?   @db.Decimal(12, 2)
  reason       String
  category     String?

  @@unique([enrollmentId, feeHeadId])
}

// A bus stop on a route (a TRANSPORT facility), priced by its slab (a SLAB facility).
model Stop {
  id         Int                   @id @default(autoincrement())
  routeId    Int
  route      Facility              @relation("RouteStops", fields: [routeId], references: [id])
  slabId     Int
  slab       Facility              @relation("SlabStops", fields: [slabId], references: [id])
  name       String
  sequence   Int
  pickupTime String?
  dropTime   String?
  pickups    TransportAssignment[] @relation("Pickup")
  drops      TransportAssignment[] @relation("Drop")

  @@unique([routeId, sequence])
  @@unique([routeId, name])
}

// Where a student boards in the morning and gets off in the afternoon. Each leg costs half
// of its stop's slab fee, so a student using one leg pays half and both legs pay the full fare.
model TransportAssignment {
  id           Int        @id @default(autoincrement())
  enrollmentId Int        @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  pickupStopId Int?
  pickupStop   Stop?      @relation("Pickup", fields: [pickupStopId], references: [id], onDelete: Restrict)
  dropStopId   Int?
  dropStop     Stop?      @relation("Drop", fields: [dropStopId], references: [id], onDelete: Restrict)
}

// A student leaving mid-year. Installments due after `date` stop being charged; the student
// is marked inactive. balanceDue / excessPaid are the settlement figures when it was recorded.
model Withdrawal {
  id           Int        @id @default(autoincrement())
  enrollmentId Int        @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  reason       String
  remarks      String?
  balanceDue   Decimal    @db.Decimal(12, 2)
  excessPaid   Decimal    @db.Decimal(12, 2)
  createdBy    String
  createdAt    DateTime   @default(now())
}

// Replaces the computed late fine of one installment for one student-year with a fixed amount
// (0 = waived). The calculated fine is ignored for that installment while this row exists.
model FineAdjustment {
  id            Int         @id @default(autoincrement())
  enrollmentId  Int
  enrollment    Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  installmentId Int
  installment   Installment @relation(fields: [installmentId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  remarks       String

  @@unique([enrollmentId, installmentId])
}

// SLAB = a transport fare tier (name + full two-way fee per installment); stops point at one.
enum FacilityKind {
  TRANSPORT
  HOSTEL
  SLAB
}

// A transport route or hostel room a school offers. Same shape for both kinds,
// so one set of models/screens covers both instead of duplicating them.
model Facility {
  id          Int                    @id @default(autoincrement())
  schoolId    Int
  school      School                 @relation(fields: [schoolId], references: [id])
  kind        FacilityKind
  name        String
  structures  FacilityFeeStructure[]
  assignments FacilityAssignment[]
  stops       Stop[]                 @relation("RouteStops")
  slabStops   Stop[]                 @relation("SlabStops")

  @@unique([schoolId, kind, name])
}

// Fee grid for one facility: amount per installment, per year.
model FacilityFeeStructure {
  id            Int          @id @default(autoincrement())
  yearId        Int
  year          AcademicYear @relation(fields: [yearId], references: [id])
  facilityId    Int
  facility      Facility     @relation(fields: [facilityId], references: [id])
  installmentId Int
  installment   Installment  @relation(fields: [installmentId], references: [id])
  amount        Decimal      @db.Decimal(12, 2)

  @@unique([yearId, facilityId, installmentId])
}

// Which route/room a student is on for a year. At most one per kind per
// enrollment; enforced in the controller (delete-then-create), not here,
// since a DB constraint would need a generated "kind" column.
model FacilityAssignment {
  id           Int        @id @default(autoincrement())
  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  facilityId   Int
  facility     Facility   @relation(fields: [facilityId], references: [id])

  @@unique([enrollmentId, facilityId])
}

// ---------------------------------------------------------------- legacy parity additions

enum Gender {
  M
  F
  OTHER
}

enum SchoolKind {
  SENIOR
  JUNIOR
}

enum SendStatus {
  QUEUED
  SENT
  FAILED
}

enum ClearStatus {
  PENDING
  CLEARED
  BOUNCED
}

enum DocType {
  TC
  ADMISSION_CERT
}

enum SubjectKind {
  LANGUAGE
  ADDITIONAL
  CORE
}

enum VoucherKind {
  CAUTION_REFUND
  ADVANCE_REFUND
  EXCESS_REFUND
  OTHER
}

enum DepositKind {
  ADVANCE
  CAUTION
  TRANSPORT
}

enum DepositStatus {
  HELD
  REFUNDED
  ADJUSTED
  FORFEITED
}

// Parent/guardian rows. isStaff marks a parent employed by the school (staff-ward report).
model Guardian {
  id            Int         @id @default(autoincrement())
  studentId     Int
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  relation      String // FATHER | MOTHER | GUARDIAN
  mobile        String?
  email         String?
  designation   String?
  organization  String?
  officeAddress String?
  officePhone   String?
  occupationId  Int?
  occupation    Occupation? @relation(fields: [occupationId], references: [id])
  isStaff       Boolean     @default(false)
  staffBranch   String?

  @@index([studentId])
}

model Occupation {
  id        Int          @id @default(autoincrement())
  schoolId  Int
  school    School       @relation(fields: [schoolId], references: [id])
  name      String
  parentId  Int?
  parent    Occupation?  @relation("OccSub", fields: [parentId], references: [id])
  children  Occupation[] @relation("OccSub")
  guardians Guardian[]

  @@unique([schoolId, name])
}

model Subject {
  id       Int              @id @default(autoincrement())
  schoolId Int
  school   School           @relation(fields: [schoolId], references: [id])
  name     String
  kind     SubjectKind
  students StudentSubject[]

  @@unique([schoolId, name])
}

model StudentSubject {
  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subjectId    Int
  subject      Subject    @relation(fields: [subjectId], references: [id])

  @@id([enrollmentId, subjectId])
}

// TC / admission certificate. Re-issue supersedes the old row; nothing is deleted.
model IssuedDocument {
  id           Int          @id @default(autoincrement())
  schoolId     Int
  school       School       @relation(fields: [schoolId], references: [id])
  studentId    Int
  student      Student      @relation(fields: [studentId], references: [id])
  yearId       Int
  year         AcademicYear @relation(fields: [yearId], references: [id])
  type         DocType
  serialNo     Int
  issuedOn     DateTime     @db.Date
  issuedBy     String
  supersededAt DateTime?
  payload      Json

  @@unique([schoolId, type, yearId, serialNo])
}

model DefaulterLetterTemplate {
  id       Int    @id @default(autoincrement())
  schoolId Int
  name     String
  body     String // placeholders: {parent} {student} {admissionNo} {class} {due} {since} {date}

  @@unique([schoolId, name])
}

// Log of letters printed / reminders sent. schoolId is scoped by the controller.
model DefaulterNotice {
  id           Int      @id @default(autoincrement())
  schoolId     Int
  enrollmentId Int
  kind         String // LETTER | SMS
  scope        String   @default("FEE")
  dueAmount    Decimal  @db.Decimal(12, 2)
  asOf         DateTime @db.Date
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([schoolId, enrollmentId])
}

model Bank {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  school    School    @relation(fields: [schoolId], references: [id])
  name      String
  accountNo String?
  ifsc      String?
  active    Boolean   @default(true)
  payments  Payment[]

  @@unique([schoolId, name])
}

// Money paid OUT to a family (refunds). Separate from Payment so collection totals are untouched.
model Voucher {
  id           Int          @id @default(autoincrement())
  schoolId     Int
  school       School       @relation(fields: [schoolId], references: [id])
  yearId       Int
  year         AcademicYear @relation(fields: [yearId], references: [id])
  enrollmentId Int
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id])
  voucherNo    Int
  date         DateTime     @db.Date
  kind         VoucherKind
  amount       Decimal      @db.Decimal(12, 2)
  mode         PaymentMode
  reference    String?
  remarks      String?
  createdBy    String
  createdAt    DateTime     @default(now())
  cancelledAt  DateTime?
  cancelReason String?

  @@unique([schoolId, yearId, voucherNo])
}

model VoucherCounter {
  schoolId Int
  yearId   Int
  last     Int

  @@id([schoolId, yearId])
}

// Refundable deposit held for a student across years (advance, caution, transport security).
model Deposit {
  id             Int           @id @default(autoincrement())
  studentId      Int
  student        Student       @relation(fields: [studentId], references: [id])
  kind           DepositKind
  amount         Decimal       @db.Decimal(12, 2)
  receivedYearId Int
  receivedYear   AcademicYear  @relation(fields: [receivedYearId], references: [id])
  paymentId      Int?
  payment        Payment?      @relation(fields: [paymentId], references: [id])
  status         DepositStatus @default(HELD)
  // true = flipped to REFUNDED because live vouchers paid it out in full (cancelling one reverts it to HELD).
  autoRefunded   Boolean       @default(false)
  refundedAt     DateTime?     @db.Date
  refundAmount   Decimal?      @db.Decimal(12, 2)
  deduction      Decimal?      @db.Decimal(12, 2)
  refundMode     PaymentMode?
  refundRef      String?
  remarks        String?
  createdBy      String
  createdAt      DateTime      @default(now())

  @@unique([studentId, kind])
}

// Opening balance of a year's enrollment = previous year's closing balance (negative = credit).
model ArrearCarry {
  id           Int          @id @default(autoincrement())
  enrollmentId Int          @unique
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  fromYearId   Int
  fromYear     AcademicYear @relation(fields: [fromYearId], references: [id])
  amount       Decimal      @db.Decimal(12, 2)
  source       String // COMPUTED | IMPORT | MANUAL
  waivedAmount Decimal      @default(0) @db.Decimal(12, 2)
  waiveReason  String?
  createdBy    String
  createdAt    DateTime     @default(now())
}

model TransportRenewal {
  id           Int        @id @default(autoincrement())
  enrollmentId Int        @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  type         String // RENEW | WITHDRAW
  status       String     @default("PENDING") // PENDING | APPLIED | SKIPPED
  note         String?
  filledBy     String
  createdAt    DateTime   @default(now())
  appliedAt    DateTime?
}

model SmsTemplate {
  id       Int     @id @default(autoincrement())
  schoolId Int
  forType  String // defaulter | receipt | general
  starting String  @default("")
  content  String
  ending   String  @default("")
  active   Boolean @default(true)

  @@index([schoolId, forType])
}

model SmsLog {
  id               Int        @id @default(autoincrement())
  schoolId         Int
  enrollmentId     Int?
  number           String
  type             String
  body             String
  status           SendStatus
  providerResponse String?
  createdAt        DateTime   @default(now())

  @@index([schoolId, createdAt])
}

model EmailTemplate {
  id       Int     @id @default(autoincrement())
  schoolId Int
  name     String
  subject  String
  body     String
  active   Boolean @default(true)

  @@index([schoolId])
}

model EmailLog {
  id               Int        @id @default(autoincrement())
  schoolId         Int
  enrollmentId     Int?
  address          String
  subject          String
  status           SendStatus
  providerResponse String?
  createdAt        DateTime   @default(now())

  @@index([schoolId, createdAt])
}

// Immutable change history. Never store password hashes in before/after.
model AuditLog {
  id        Int      @id @default(autoincrement())
  schoolId  Int?
  username  String
  entity    String
  entityId  Int?
  action    String // CREATE | UPDATE | DELETE | CANCEL
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([schoolId, entity, createdAt])
}

// Whitelisted per-school key/value settings.
model Setting {
  schoolId Int
  key      String
  value    Json

  @@id([schoolId, key])
}
