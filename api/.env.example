DATABASE_URL="postgresql://fees:fees@localhost:5432/fees?schema=public"
# Required. Replace with a long random string (e.g. `openssl rand -hex 32`); the placeholder is rejected in production.
JWT_SECRET="change-me-in-production"
PORT=3100

# Optional (see README):
# SEED_ADMIN_PASSWORD=       # password for the seeded `admin` (default admin123)
# DISABLE_DOCS=true          # turn off /api/docs on a public server
# DB_POOL_MAX=10             # pg pool size per process
# SMS_PROVIDER=stub          # log only; no real provider built in
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM=   # needs `npm i nodemailer`
